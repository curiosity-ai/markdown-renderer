<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyName>MarkdownRenderer</AssemblyName>
    <AssemblyTitle>MarkdownRenderer</AssemblyTitle>
    <PackageId>MarkdownRenderer</PackageId>
    <Title>Markdown Renderer</Title>
    <Product>MarkdownRenderer</Product>
    <Description>.NET library for converting markdown to Office documents. The MarkdownRenderer package provides Markdown to DOCX and PPTX conversion.</Description>
    <PackageTags>markdown docx pptx convert converter markdig renderer openxml office word markdown-renderer md</PackageTags>

    <Authors>Curiosity GmbH</Authors>
    <Product>MarkdownRenderer</Product>
    <Company>Curiosity GmbH</Company>
    <Version>0.0.42</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/curiosity-ai/markdown-renderer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/curiosity-ai/markdown-renderer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>(c) Copyright 2026 Curiosity GmbH, Copyright (c) 2024 Manfredi Marceca, Copyright (c) Microsoft Corporation</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- For including project references -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Docx\Resources\markdown-template.docx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docx\Resources\markdown-template.docx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="runtime.osx.10.10-x64.CoreCompat.System.Drawing" Version="6.0.5.128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer.Docx\MarkdownRenderer.Docx.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\MarkdownRenderer.Slides\MarkdownRenderer.Slides.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\MarkdownRenderer.Common\MarkdownRenderer.Common.csproj" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <!-- Filter out unnecessary files -->
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths-&gt;WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>
</Project>
