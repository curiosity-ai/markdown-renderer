<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- NuGet package -->
  <PropertyGroup>
    <AssemblyName>MarkdownRenderer.Markdown</AssemblyName>
    <AssemblyTitle>MarkdownRenderer.Markdown</AssemblyTitle>
    <PackageId>MarkdownRenderer.Markdown</PackageId>
    <Title>MarkdownRenderer.Markdown</Title>
    <Description>.NET library for converting documents. The MarkdownRenderer.Markdown package provides Markdown to DOCX and RTF conversion.</Description>
    <PackageTags>markdown docx rtf convert converter markdig renderer openxml office word MarkdownRenderer md</PackageTags>

    <!-- Required NuGet properties -->
    <Authors>AuthorPlaceholder</Authors>
    <Company>CompanyPlaceholder</Company>
    <Product>ProductPlaceholder</Product>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/placeholder/MarkdownRenderer</PackageProjectUrl>
    <RepositoryUrl>https://github.com/placeholder/MarkdownRenderer.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- For including project references -->
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CopyProjectReferencesToPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Docx\Resources\markdown-template.docx" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Docx\Resources\markdown-template.docx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.1.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.4.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.5" />
    <PackageReference Include="runtime.osx.10.10-x64.CoreCompat.System.Drawing" Version="6.0.5.128" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MarkdownRenderer.Docx\MarkdownRenderer.Docx.csproj" PrivateAssets="All" />
    <ProjectReference Include="..\MarkdownRenderer.Slides\MarkdownRenderer.Slides.csproj" PrivateAssets="All" />
    <!-- Since Docx references Common, we also need to pack Common -->
    <ProjectReference Include="..\MarkdownRenderer.Common\MarkdownRenderer.Common.csproj" PrivateAssets="All" />
  </ItemGroup>

  <Target Name="CopyProjectReferencesToPackage" DependsOnTargets="BuildOnlySettings;ResolveReferences">
    <ItemGroup>
      <!-- Filter out unnecessary files -->
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths->WithMetadataValue('ReferenceSourceTarget', 'ProjectReference'))" />
    </ItemGroup>
  </Target>
</Project>
